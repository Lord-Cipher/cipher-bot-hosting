# Cipher Bot Hosting — universal environment template
#
# Copy this file to .env for local/VPS use. Railway, Render, Replit and other
# panels should define the same names in their secret/environment settings.
# Process/platform variables always override values from .env.
# Never commit .env or real secret values.

# REQUIRED -------------------------------------------------------------------
# Telegram BotFather token
BOT_TOKEN=

# Telegram user ID that receives owner/admin access
OWNER_ID=

# OPTIONAL TELEGRAM / WEBHOOK ------------------------------------------------
# A 32-character secret. Blank = generated automatically at startup.
TELEGRAM_WEBHOOK_SECRET=
# Chat ID used by deployments that need a target chat
CHAT_ID=
# Public HTTPS URL. Railway/Render URLs are detected automatically when blank.
PUBLIC_URL=
# true/false. With a public URL, webhook mode can be enabled.
WEBHOOK_ENABLED=false
# Set 1 for managed short polling, 80 for VPS long polling, or leave blank.
POLLING_TIMEOUT=
# Hosting panel port; Railway/Render/Replit usually inject PORT automatically.
PORT=10460

# PLATFORM OVERRIDES ---------------------------------------------------------
# Usually supplied by the platform, not entered manually:
# RAILWAY_PUBLIC_DOMAIN=
# RAILWAY_STATIC_URL=
# RAILWAY_ENVIRONMENT_ID=
# RAILWAY_PROJECT_ID=
# RENDER_EXTERNAL_URL=
# RENDER_SERVICE_ID=
# REPL_ID=
# REPLIT_DB_URL=

# PAYMENTS -------------------------------------------------------------------
OXAPAY_API_KEY=

# AI / OMEGA -----------------------------------------------------------------
# Optional provider credentials. The runtime catalog can also be managed in
# the admin panel without redeploying.
OPENAI_API_KEY=
OMEGA_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# DATABASE -------------------------------------------------------------------
# Optional. The built-in JSON storage remains the fallback when blank.
DATABASE_URL=
PGDATABASE=
PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=

# GITHUB / BACKUP ------------------------------------------------------------
GITHUB_TOKEN=
GITHUB_REPO=your-org/your-private-repo
GITHUB_BRANCH=main
GITHUB_AUTO_INTERVAL_MIN=360

# CIPHER VAULT ----------------------------------------------------------------
# The panel can generate the vault key automatically. Only set CIPHER_VAULT_KEY
# when importing an existing vault.
CIPHER_VAULT_REPO=your-org/your-private-vault-repo
CIPHER_VAULT_TOKEN=
CIPHER_VAULT_KEY=
CIPHER_VAULT_BRANCH=main
CIPHER_VAULT_CONFIG=
CIPHER_RECOVERY_PASSPHRASE=

# OPTIONAL BRANDING / OPERATIONS --------------------------------------------
ANNOUNCE_CHANNEL=
FORCE_POLLING=false
PLATFORM=
