# 🤖 Telegram Bot Token from @BotFather
BOT_TOKEN=

# 👤 Your Telegram User ID (for Admin access)
OWNER_ID=

# Optional: 32-character Telegram webhook secret. If blank, one is generated at startup.
TELEGRAM_WEBHOOK_SECRET=

# Cipher Vault private GitHub backup settings
CIPHER_VAULT_REPO=Lord-Cipher/cipher-vault
CIPHER_VAULT_TOKEN=
CIPHER_VAULT_KEY=
CIPHER_VAULT_BRANCH=main

# 💳 OxaPay Merchant API Key (for automatic payments)
OXAPAY_API_KEY=

# 📢 Optional: Telegram Channel ID for announcements (e.g. -100123456789)
ANNOUNCE_CHANNEL=

# 🌐 Optional: Server Port (default: 10460)
PORT=10460
