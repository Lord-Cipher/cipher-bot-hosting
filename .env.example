# Cipher Bot Hosting — deployment bootstrap variables
#
# Copy this file to .env for local/VPS deployment. Railway, Render, Replit,
# Docker, and other panels can define these same variables in their settings.
# Platform-provided variables always take priority over this file.
# Never commit .env or real secret values.
#
# Integration credentials, backup credentials, vault keys, payment keys, and
# AI/Omega provider keys are configured securely from the admin panel. They are
# intentionally not listed here.

# REQUIRED -------------------------------------------------------------------
# Telegram BotFather token
BOT_TOKEN=

# Telegram user ID that receives owner/admin access
OWNER_ID=

# OPTIONAL DEPLOYMENT --------------------------------------------------------
# Public HTTPS URL. Railway/Render URLs are detected automatically when blank.
PUBLIC_URL=
# true/false. Enable only when a public HTTPS URL is available.
WEBHOOK_ENABLED=false
# Leave blank for automatic host selection; use 1 for managed short polling
# or 80 for a VPS long-polling deployment.
POLLING_TIMEOUT=
# Railway/Render/Replit normally inject PORT automatically.
PORT=10460
# Optional platform database URL. JSON storage remains the fallback when blank.
DATABASE_URL=

# PLATFORM-PROVIDED VARIABLES ------------------------------------------------
# Usually injected automatically by the hosting platform; do not enter these
# manually unless your platform requires it.
# RAILWAY_PUBLIC_DOMAIN=
# RAILWAY_STATIC_URL=
# RAILWAY_ENVIRONMENT_ID=
# RAILWAY_PROJECT_ID=
# RENDER_EXTERNAL_URL=
# RENDER_SERVICE_ID=
# REPL_ID=
# REPLIT_DB_URL=

# OPTIONAL OPERATIONS --------------------------------------------------------
ANNOUNCE_CHANNEL=
FORCE_POLLING=false
PLATFORM=
